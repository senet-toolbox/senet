const std = @import("std");
const Vapor = @import("vapor");
const Text = Vapor.Text;
const Box = Vapor.Box;
const ButtonCtx = Vapor.CtxButton;
const Button = Vapor.Button;

var background: Vapor.Types.Background = .palette(.background);
var border_color: Vapor.Types.Color = .hex("#e4e4e4");
var tooltips: std.AutoHashMap(usize, *TooltipOptions) = undefined;

pub fn new() void {
    tooltips = std.AutoHashMap(usize, *TooltipOptions).init(Vapor.arena(.persist));
}

const ToolTip = @This();
component: ?*const fn () void = null,

const Position = struct {
    x: f32,
    y: f32,
};

const TooltipOptions = struct {
    position: Position,
    binded: *Vapor.Binded,
    tooltip_binded: *Vapor.Binded,
    show: bool = false,
};

fn onHover(options: *TooltipOptions, _: *Vapor.Event) void {
    options.show = true;
    // options.tooltip_binded.mutateStyleString("display", "block");

    const bounds = options.binded.getBoundingClientRect() orelse return;
    const tooltip_bounds = options.tooltip_binded.getBoundingClientRect() orelse return;
    options.position.x = bounds.left + bounds.width / 2 - tooltip_bounds.width / 2;
    options.position.y = bounds.top - tooltip_bounds.height - 8;

    Vapor.print("Bounds {any}", .{bounds});
}

fn onLeave(options: *TooltipOptions, _: *Vapor.Event) void {
    options.show = false;
    // options.tooltip_binded.mutateStyleString("display", "none");
}

// fn mount(options: *TooltipOptions) void {
//     options.tooltip_binded.mutateStyleString("display", "none");
// }

pub fn render(component: *const fn () void) void {
    const stable_id = @intFromPtr(component);

    const options = tooltips.get(stable_id) orelse blk: {
        const binded: *Vapor.Binded = Vapor.arena(.persist).create(Vapor.Binded) catch unreachable;
        binded.* = .{};

        const tooltip_binded: *Vapor.Binded = Vapor.arena(.persist).create(Vapor.Binded) catch unreachable;
        tooltip_binded.* = .{};

        const options = Vapor.arena(.persist).create(TooltipOptions) catch unreachable;
        options.* = .{
            .position = .{ .x = 0, .y = 0 },
            .binded = binded,
            .tooltip_binded = tooltip_binded,
            .show = false,
        };

        tooltips.put(stable_id, options) catch unreachable;
        break :blk options;
    };

    // Vapor.Static.HooksCtx(.mounted, mount, .{options})({
    Box()
        .ref(options.binded)
        .height(.px(60))
        .width(.px(300))
        .onEventCtx(.pointerenter, onHover, options)
        .onEventCtx(.pointerleave, onLeave, options)
        .background(.blue)
        .children({
        Text("Hover me").end();
    });
    // });
    if (options.show) {
        Box()
            .ref(options.tooltip_binded)
            .pos(.tl(.px(0), .px(0), .fixed))
            .inlineStyle("transform: translate({d}px, {d}px)", .{ options.position.x, options.position.y })
            .background(.red)
            .width(.px(100))
            .height(.px(100))
            .children({
            Text("Hover").end();
            @call(.auto, component, .{});
        });
    }
}
